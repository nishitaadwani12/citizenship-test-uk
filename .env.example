# Firebase web config (from Firebase console → Project settings → Your apps).
# These are client-side keys (safe to ship), but keep them out of git.
# Copy to .env.local and fill in to activate email/phone/Google/Apple sign-in.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google OAuth client IDs (Google Cloud console). Needed for Google sign-in.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# AdMob (Google AdMob console). If unset, the app shows Google TEST ads.
# App IDs (per platform) — required for production ads:
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# Ad-unit IDs for the banner and interstitial placements:
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
